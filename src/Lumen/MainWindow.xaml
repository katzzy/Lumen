<Window x:Class="Lumen.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Lumen Terminal"
        Width="1320"
        Height="820"
        MinWidth="980"
        MinHeight="620"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{StaticResource Brush.Window}"
        Icon="Assets/lumen.ico"
        FontFamily="{StaticResource Font.UI}"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        RenderOptions.ClearTypeHint="Enabled"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <DataTemplate x:Key="PortItemTemplate">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="52" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding PortName}" FontSize="12" FontWeight="SemiBold" />
                <TextBlock Grid.Column="1"
                           Text="{Binding DisplayName}"
                           FontSize="11"
                           Foreground="{StaticResource Brush.TextMuted}"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center" />
                <TextBlock Grid.Column="2"
                           Text="{Binding KindLabel}"
                           FontSize="10"
                           Foreground="{StaticResource Brush.Accent}"
                           Margin="6,0,0,0"
                           VerticalAlignment="Center" />
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Border x:Name="RootBorder"
            Background="{StaticResource Brush.WindowBackdrop}"
            BorderBrush="{StaticResource Brush.Border}"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="46" />
                <RowDefinition Height="*" />
                <RowDefinition Height="26" />
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <Grid x:Name="TitleBar"
                  Grid.Row="0"
                  Background="{StaticResource Brush.TitleBar}"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" Margin="12,0,6,0" VerticalAlignment="Center">
                    <Border Width="26" Height="26" CornerRadius="7" Background="{StaticResource Brush.Logo}">
                        <Viewbox Width="15" Height="13">
                            <Canvas Width="24" Height="20">
                                <Path Data="M 2 3 L 10 10 L 2 17"
                                      Stroke="White"
                                      StrokeThickness="2.6"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round" />
                                <Path Data="M 13 17 L 22 17"
                                      Stroke="White"
                                      StrokeThickness="2.6"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round" />
                            </Canvas>
                        </Viewbox>
                    </Border>
                    <TextBlock Text="Lumen"
                               Margin="9,0,0,0"
                               FontSize="14"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                    <Border Width="1" Height="16" Background="{StaticResource Brush.Border}" Margin="12,0,8,0" />
                    <Button x:Name="NewSessionButton"
                            Style="{StaticResource BtnIcon}"
                            Content="&#xE710;"
                            Width="26"
                            Height="26"
                            FontSize="11"
                            ToolTip="新建会话" AutomationProperties.Name="新建会话"
                            Click="NewSession_Click" />
                </StackPanel>

                <ScrollViewer x:Name="TabScroll"
                              Grid.Column="1"
                              VerticalScrollBarVisibility="Disabled"
                              HorizontalScrollBarVisibility="Hidden"
                              VerticalAlignment="Center"
                              PreviewMouseWheel="TabScroll_PreviewMouseWheel">
                    <StackPanel x:Name="TabStrip" Orientation="Horizontal" VerticalAlignment="Center" />
                </ScrollViewer>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button x:Name="MinimizeButton"
                            Style="{StaticResource CaptionButton}"
                            Content="&#xE921;"
                            ToolTip="最小化" AutomationProperties.Name="最小化"
                            Click="Minimize_Click" />
                    <Button x:Name="MaximizeButton"
                            Style="{StaticResource CaptionButton}"
                            Content="&#xE922;"
                            ToolTip="最大化" AutomationProperties.Name="最大化"
                            Click="Maximize_Click" />
                    <Button x:Name="CloseButton"
                            Style="{StaticResource CaptionClose}"
                            Content="&#xE8BB;"
                            ToolTip="关闭" AutomationProperties.Name="关闭"
                            Click="Close_Click" />
                </StackPanel>
            </Grid>

            <!-- Body -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="256" />
                    <ColumnDefinition Width="1" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Sidebar -->
                <Border Grid.Column="0" Background="#0B0E13">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Margin="14,14,10,8">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="会话" FontSize="13" FontWeight="SemiBold" />
                                <Border Background="{StaticResource Brush.Surface}"
                                        CornerRadius="5"
                                        Padding="6,1"
                                        Margin="8,0,0,0">
                                    <TextBlock x:Name="SessionCount"
                                               Text="0"
                                               FontSize="10"
                                               Foreground="{StaticResource Brush.TextMuted}" />
                                </Border>
                            </StackPanel>
                            <Button HorizontalAlignment="Right"
                                    Style="{StaticResource BtnIcon}"
                                    Content="&#xE710;"
                                    Width="26"
                                    Height="26"
                                    FontSize="11"
                                    ToolTip="新建会话" AutomationProperties.Name="新建会话"
                                    Click="NewSession_Click" />
                        </Grid>

                        <!-- Quick connect -->
                        <Border Grid.Row="1"
                                Margin="12,0,12,10"
                                Padding="12"
                                Background="{StaticResource Brush.Surface}"
                                BorderBrush="{StaticResource Brush.Border}"
                                BorderThickness="1"
                                CornerRadius="10">
                            <StackPanel>
                                <Grid>
                                    <TextBlock Text="快速连接" Style="{StaticResource Text.Section}" VerticalAlignment="Center" />
                                    <Button HorizontalAlignment="Right"
                                            Style="{StaticResource BtnIcon}"
                                            Content="&#xE72C;"
                                            Width="22"
                                            Height="22"
                                            FontSize="11"
                                            ToolTip="刷新串口列表" AutomationProperties.Name="刷新串口"
                                            Click="RefreshPorts_Click" />
                                </Grid>
                                <ComboBox x:Name="PortCombo"
                                          Height="32"
                                          Margin="0,8,0,0"
                                          ToolTip="选择串口"
                                          SelectionChanged="PortCombo_SelectionChanged" />
                                <TextBlock x:Name="PortHint"
                                           Text=""
                                           FontSize="10"
                                           Foreground="{StaticResource Brush.TextMuted}"
                                           TextTrimming="CharacterEllipsis"
                                           Margin="2,4,0,0" />
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="84" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="BaudText"
                                             Height="32"
                                             Text="9600"
                                             ToolTip="波特率"
                                             VerticalContentAlignment="Top" />
                                    <Button x:Name="QuickConnectButton"
                                            Grid.Column="2"
                                            Content="连接控制台"
                                            Style="{StaticResource BtnPrimary}"
                                            Height="32"
                                            Click="QuickConnect_Click" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Search -->
                        <Grid Grid.Row="2" Margin="12,0,12,8">
                            <TextBox x:Name="SessionSearch"
                                     Height="32"
                                     TextChanged="SessionSearch_TextChanged"
                                     VerticalContentAlignment="Top" />
                            <TextBlock x:Name="SearchPlaceholder"
                                       Text="搜索名称或串口"
                                       Margin="12,0,0,0"
                                       Foreground="{StaticResource Brush.TextMuted}"
                                       FontSize="12"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False" />
                        </Grid>

                        <ListBox x:Name="SessionList"
                                 Grid.Row="3"
                                 Style="{StaticResource SessionListStyle}"
                                 Margin="0,2,0,8"
                                 MouseDoubleClick="SessionList_MouseDoubleClick"
                                 PreviewMouseRightButtonDown="SessionList_PreviewMouseRightButtonDown">
                            <ListBox.GroupStyle>
                                <GroupStyle>
                                    <GroupStyle.HeaderTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="14,10,0,4">
                                                <TextBlock Text="{Binding Name}"
                                                           FontSize="11"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource Brush.TextMuted}" />
                                                <TextBlock Text="{Binding ItemCount}"
                                                           FontSize="10"
                                                           Margin="6,0,0,0"
                                                           Foreground="{StaticResource Brush.TextMuted}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </GroupStyle.HeaderTemplate>
                                </GroupStyle>
                            </ListBox.GroupStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="20" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="7"
                                                Height="7"
                                                CornerRadius="4"
                                                Background="{StaticResource Brush.Accent}"
                                                Opacity="0.75"
                                                VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" Margin="2,0,0,0">
                                            <TextBlock Text="{Binding Name}"
                                                       FontSize="13"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding DisplaySummary}"
                                                       FontSize="11"
                                                       Foreground="{StaticResource Brush.TextMuted}"
                                                       Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                            <ListBox.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="连接" Click="SessionContext_Connect" />
                                    <MenuItem Header="编辑" Click="SessionContext_Edit" />
                                    <MenuItem Header="复制会话" Click="SessionContext_Duplicate" />
                                    <Separator />
                                    <MenuItem Header="删除" Foreground="{StaticResource Brush.Red}" Click="SessionContext_Delete" />
                                </ContextMenu>
                            </ListBox.ContextMenu>
                        </ListBox>

                        <Border Grid.Row="4"
                                BorderBrush="{StaticResource Brush.BorderSoft}"
                                BorderThickness="0,1,0,0"
                                Padding="10,8">
                            <Grid>
                                <Button HorizontalAlignment="Left"
                                        Style="{StaticResource BtnGhost}"
                                        Padding="6,4"
                                        AutomationProperties.Name="设置" Click="Settings_Click"
                                        ToolTip="设置">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE713;"
                                                   FontFamily="{StaticResource Font.Icons}"
                                                   FontSize="13"
                                                   Foreground="{StaticResource Brush.TextSecondary}" />
                                        <TextBlock Text="设置" Margin="8,0,0,0" FontSize="12" />
                                    </StackPanel>
                                </Button>
                                <TextBlock Text="Lumen 1.2"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center"
                                           FontSize="10"
                                           Foreground="{StaticResource Brush.TextMuted}" />
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <Border Grid.Column="1" Background="{StaticResource Brush.BorderSoft}" />

                <!-- Workspace -->
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="42" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Background="#0D1015"
                            BorderBrush="{StaticResource Brush.BorderSoft}"
                            BorderThickness="0,0,0,1">
                        <Grid Margin="14,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Grid Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border x:Name="ActiveDot"
                                        Width="7"
                                        Height="7"
                                        CornerRadius="4"
                                        Background="{StaticResource Brush.TextMuted}"
                                        VerticalAlignment="Center" />
                                <TextBlock x:Name="ActiveTitle"
                                           Grid.Column="1"
                                           Text="未连接"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Margin="8,0,0,0"
                                           MaxWidth="240"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center" />
                                <Border Grid.Column="2"
                                        Width="1"
                                        Height="14"
                                        Background="{StaticResource Brush.Border}"
                                        Margin="10,0" />
                                <TextBlock x:Name="ActiveSubtitle"
                                           Grid.Column="3"
                                           Text="选择左侧会话，或使用快速连接"
                                           FontSize="12"
                                           Foreground="{StaticResource Brush.TextMuted}"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center" />
                            </Grid>

                            <StackPanel Grid.Column="1"
                                        Orientation="Horizontal"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center">
                                <Button x:Name="ReconnectButton"
                                        Content="重连"
                                        Style="{StaticResource BtnTool}"
                                        ToolTip="关闭当前标签并重新连接串口"
                                        Click="Reconnect_Click" />
                                <Button x:Name="BreakButton"
                                        Content="Break"
                                        Style="{StaticResource BtnTool}"
                                        ToolTip="发送 Break（交换机进入 ROMMON / 密码恢复）；右键选择脉冲时长"
                                        Click="Break_Click">
                                    <Button.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Break 100 ms" Tag="100" Click="BreakDuration_Click" />
                                            <MenuItem Header="Break 250 ms" Tag="250" Click="BreakDuration_Click" />
                                            <MenuItem Header="Break 500 ms" Tag="500" Click="BreakDuration_Click" />
                                            <MenuItem Header="Break 1000 ms" Tag="1000" Click="BreakDuration_Click" />
                                            <MenuItem Header="Break 2000 ms" Tag="2000" Click="BreakDuration_Click" />
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                </Button>
                                <ToggleButton x:Name="DtrToggle"
                                              Content="DTR"
                                              Style="{StaticResource BtnToggle}"
                                              ToolTip="数据终端就绪信号"
                                              Margin="2,0,0,0"
                                              Checked="DtrToggle_Changed"
                                              Unchecked="DtrToggle_Changed" />
                                <ToggleButton x:Name="RtsToggle"
                                              Content="RTS"
                                              Style="{StaticResource BtnToggle}"
                                              ToolTip="请求发送信号"
                                              Margin="2,0,0,0"
                                              Checked="RtsToggle_Changed"
                                              Unchecked="RtsToggle_Changed" />
                                <Border Width="1" Height="16" Background="{StaticResource Brush.Border}" Margin="8,0" />
                                <Button x:Name="LogButton"
                                        Content="日志"
                                        Style="{StaticResource BtnTool}"
                                        ToolTip="开始 / 停止记录本次会话"
                                        Click="Log_Click" />
                                <Button x:Name="LogFolderButton"
                                        Content="日志目录"
                                        Style="{StaticResource BtnTool}"
                                        ToolTip="打开日志保存目录"
                                        Click="OpenLogFolder_Click" />
                                <Button x:Name="QuickCommandButton"
                                        Content="快捷命令"
                                        Style="{StaticResource BtnTool}"
                                        ToolTip="常用命令面板"
                                        Click="QuickCommands_Click" />
                                <Button x:Name="SendBytesButton"
                                        Content="字节"
                                        Style="{StaticResource BtnTool}"
                                        ToolTip="发送任意字节 / 转义序列（Ctrl+Shift+H）"
                                        Click="SendBytes_Click" />
                                <ToggleButton x:Name="HexToggle"
                                              Content="Hex"
                                              Style="{StaticResource BtnToggle}"
                                              ToolTip="切换十六进制接收视图"
                                              Margin="2,0,0,0"
                                              Click="HexToggle_Click" />
                                <Button x:Name="ClearButton"
                                        Content="清屏"
                                        Style="{StaticResource BtnTool}"
                                        ToolTip="仅清除本机显示，不发送到设备"
                                        Click="Clear_Click" />
                                <Button x:Name="FindButton"
                                        Content="查找"
                                        Style="{StaticResource BtnTool}"
                                        ToolTip="在当前会话中查找（Ctrl+F）"
                                        Click="Find_Click" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1" Background="#0B0E13">
                        <Grid x:Name="TerminalPanes" ClipToBounds="True" />

                        <!-- Empty state -->
                        <Grid x:Name="EmptyState">
                            <StackPanel HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        MaxWidth="520">
                                <Border Width="58"
                                        Height="58"
                                        CornerRadius="16"
                                        Background="{StaticResource Brush.Logo}"
                                        HorizontalAlignment="Center">
                                    <Viewbox Width="30" Height="26">
                                        <Canvas Width="24" Height="20">
                                            <Path Data="M 2 3 L 10 10 L 2 17"
                                                  Stroke="White"
                                                  StrokeThickness="2.6"
                                                  StrokeStartLineCap="Round"
                                                  StrokeEndLineCap="Round"
                                                  StrokeLineJoin="Round" />
                                            <Path Data="M 13 17 L 22 17"
                                                  Stroke="White"
                                                  StrokeThickness="2.6"
                                                  StrokeStartLineCap="Round"
                                                  StrokeEndLineCap="Round" />
                                        </Canvas>
                                    </Viewbox>
                                </Border>
                                <TextBlock Text="连接你的第一台设备"
                                           FontFamily="{StaticResource Font.Display}"
                                           FontSize="23"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center"
                                           Margin="0,20,0,0" />
                                <TextBlock Text="为网络运维打造的串口控制台。选择左侧会话，或直接输入串口与波特率开始。"
                                           Foreground="{StaticResource Brush.TextSecondary}"
                                           FontSize="13"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap"
                                           Margin="0,8,0,0" />
                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Center"
                                            Margin="0,24,0,0">
                                    <Button Content="新建会话"
                                            Style="{StaticResource BtnPrimary}"
                                            Padding="18,9"
                                            Click="NewSession_Click" />
                                    <Button Content="打开演示会话"
                                            Style="{StaticResource BtnSecondary}"
                                            Padding="18,9"
                                            Margin="10,0,0,0"
                                            Click="Demo_Click" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Center"
                                            Margin="0,22,0,0">
                                    <TextBlock Text="串口"
                                               FontSize="11"
                                               Foreground="{StaticResource Brush.TextMuted}" />
                                    <TextBlock Text="·"
                                               FontSize="11"
                                               Margin="8,0"
                                               Foreground="{StaticResource Brush.Border}" />
                                    <TextBlock Text="自动日志"
                                               FontSize="11"
                                               Foreground="{StaticResource Brush.TextMuted}" />
                                    <TextBlock Text="·"
                                               FontSize="11"
                                               Margin="8,0"
                                               Foreground="{StaticResource Brush.Border}" />
                                    <TextBlock Text="带节流粘贴"
                                               FontSize="11"
                                               Foreground="{StaticResource Brush.TextMuted}" />
                                    <TextBlock Text="·"
                                               FontSize="11"
                                               Margin="8,0"
                                               Foreground="{StaticResource Brush.Border}" />
                                    <TextBlock Text="Break / DTR / RTS"
                                               FontSize="11"
                                               Foreground="{StaticResource Brush.TextMuted}" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>

                        <!-- Find bar -->
                        <Border x:Name="FindBar"
                                Visibility="Collapsed"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Margin="0,10,22,0"
                                Padding="10"
                                Background="{StaticResource Brush.SurfaceAlt}"
                                BorderBrush="{StaticResource Brush.Border}"
                                BorderThickness="1"
                                CornerRadius="9">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.35" Color="Black" />
                            </Border.Effect>
                            <StackPanel Orientation="Horizontal">
                                <TextBox x:Name="FindBox"
                                         Width="210"
                                         Height="30"
                                         Padding="0"
                                         VerticalContentAlignment="Top"
                                         TextChanged="FindBox_TextChanged"
                                         KeyDown="FindBox_KeyDown" />
                                <TextBlock x:Name="FindCount"
                                           Text="0 项"
                                           FontSize="11"
                                           Foreground="{StaticResource Brush.TextMuted}"
                                           VerticalAlignment="Center"
                                           Margin="10,0,6,0"
                                           MinWidth="42" />
                                <Button Style="{StaticResource BtnIcon}"
                                        Content="&#xE70E;"
                                        Width="26"
                                        Height="26"
                                        FontSize="10"
                                        ToolTip="上一个" AutomationProperties.Name="上一个"
                                        Click="FindPrev_Click" />
                                <Button Style="{StaticResource BtnIcon}"
                                        Content="&#xE70D;"
                                        Width="26"
                                        Height="26"
                                        FontSize="10"
                                        ToolTip="下一个" AutomationProperties.Name="下一个"
                                        Click="FindNext_Click" />
                                <Button Style="{StaticResource BtnIcon}"
                                        Content="&#xE711;"
                                        Width="26"
                                        Height="26"
                                        FontSize="10"
                                        ToolTip="关闭" AutomationProperties.Name="关闭"
                                        Click="FindClose_Click" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>

            <!-- Status bar -->
            <Border Grid.Row="2"
                    Background="#0B0E13"
                    BorderBrush="{StaticResource Brush.BorderSoft}"
                    BorderThickness="0,1,0,0">
                <Grid Margin="12,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border x:Name="StatusDot"
                                Width="6"
                                Height="6"
                                CornerRadius="3"
                                Background="{StaticResource Brush.TextMuted}"
                                VerticalAlignment="Center" />
                        <TextBlock x:Name="StatusText"
                                   Text="就绪"
                                   FontSize="11"
                                   Foreground="{StaticResource Brush.TextSecondary}"
                                   Margin="7,0,0,0"
                                   VerticalAlignment="Center"
                                   MaxWidth="540"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <TextBlock x:Name="ThroughputText"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontSize="11"
                               FontFamily="{StaticResource Font.Mono}"
                               Foreground="{StaticResource Brush.TextMuted}" />

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                        <TextBlock x:Name="LogText"
                                   Text="○ 未记录"
                                   FontSize="11"
                                   Foreground="{StaticResource Brush.TextMuted}"
                                   VerticalAlignment="Center" />
                        <Border Width="1" Height="12" Background="{StaticResource Brush.Border}" Margin="10,0" />
                        <TextBlock x:Name="CursorText"
                                   Text="80 × 24"
                                   FontSize="11"
                                   FontFamily="{StaticResource Font.Mono}"
                                   Foreground="{StaticResource Brush.TextMuted}"
                                   VerticalAlignment="Center" />
                        <Border Width="1" Height="12" Background="{StaticResource Brush.Border}" Margin="10,0" />
                        <TextBlock x:Name="EncodingText"
                                   Text="UTF-8"
                                   FontSize="11"
                                   Foreground="{StaticResource Brush.TextMuted}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid x:Name="OverlayHost"
                  Grid.RowSpan="3"
                  Panel.ZIndex="20"
                  Background="#B8000000"
                  Visibility="Collapsed" />
        </Grid>
    </Border>
</Window>
