<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Color x:Key="Color.Bg">#0F1216</Color>
    <Color x:Key="Color.BgDeep">#0A0D11</Color>
    <Color x:Key="Color.Surface">#151A22</Color>
    <Color x:Key="Color.SurfaceAlt">#1A2029</Color>
    <Color x:Key="Color.SurfaceHover">#222A36</Color>
    <Color x:Key="Color.SurfaceActive">#26303D</Color>
    <Color x:Key="Color.Border">#242B36</Color>
    <Color x:Key="Color.BorderSoft">#1C222C</Color>
    <Color x:Key="Color.Text">#E7ECF5</Color>
    <Color x:Key="Color.TextSecondary">#9AA4B8</Color>
    <Color x:Key="Color.TextMuted">#6B7488</Color>
    <Color x:Key="Color.Accent">#4C8DFF</Color>
    <Color x:Key="Color.AccentSoft">#1D3154</Color>
    <Color x:Key="Color.Green">#3FB950</Color>
    <Color x:Key="Color.Amber">#D29922</Color>
    <Color x:Key="Color.Red">#F85149</Color>
    <Color x:Key="Color.Cyan">#22D3EE</Color>

    <SolidColorBrush x:Key="Brush.Window" Color="{StaticResource Color.Bg}" />
    <SolidColorBrush x:Key="Brush.BgDeep" Color="{StaticResource Color.BgDeep}" />
    <SolidColorBrush x:Key="Brush.Surface" Color="{StaticResource Color.Surface}" />
    <SolidColorBrush x:Key="Brush.SurfaceAlt" Color="{StaticResource Color.SurfaceAlt}" />
    <SolidColorBrush x:Key="Brush.SurfaceHover" Color="{StaticResource Color.SurfaceHover}" />
    <SolidColorBrush x:Key="Brush.SurfaceActive" Color="{StaticResource Color.SurfaceActive}" />
    <SolidColorBrush x:Key="Brush.Border" Color="{StaticResource Color.Border}" />
    <SolidColorBrush x:Key="Brush.BorderSoft" Color="{StaticResource Color.BorderSoft}" />
    <SolidColorBrush x:Key="Brush.Text" Color="{StaticResource Color.Text}" />
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="{StaticResource Color.TextSecondary}" />
    <SolidColorBrush x:Key="Brush.TextMuted" Color="{StaticResource Color.TextMuted}" />
    <SolidColorBrush x:Key="Brush.Accent" Color="{StaticResource Color.Accent}" />
    <SolidColorBrush x:Key="Brush.AccentSoft" Color="{StaticResource Color.AccentSoft}" />
    <SolidColorBrush x:Key="Brush.Green" Color="{StaticResource Color.Green}" />
    <SolidColorBrush x:Key="Brush.Amber" Color="{StaticResource Color.Amber}" />
    <SolidColorBrush x:Key="Brush.Red" Color="{StaticResource Color.Red}" />
    <SolidColorBrush x:Key="Brush.Cyan" Color="{StaticResource Color.Cyan}" />
    <SolidColorBrush x:Key="Brush.White" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="Brush.Transparent" Color="Transparent" />

    <LinearGradientBrush x:Key="Brush.Logo" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#3B82F6" Offset="0" />
        <GradientStop Color="#22D3EE" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="Brush.WindowBackdrop" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#141922" Offset="0" />
        <GradientStop Color="#0C0F14" Offset="0.55" />
        <GradientStop Color="#0A0D11" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="Brush.TitleBar" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#11161D" Offset="0" />
        <GradientStop Color="#0E1218" Offset="1" />
    </LinearGradientBrush>

    <FontFamily x:Key="Font.UI">Segoe UI</FontFamily>
    <FontFamily x:Key="Font.Display">Segoe UI</FontFamily>
    <FontFamily x:Key="Font.Mono">Consolas</FontFamily>
    <FontFamily x:Key="Font.Icons">Segoe Fluent Icons</FontFamily>

</ResourceDictionary>
