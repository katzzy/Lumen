<UserControl x:Class="Lumen.Views.ConfirmView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="440"
             Focusable="True"
             KeyDown="Root_KeyDown"
             Loaded="Root_Loaded">
    <Border Background="{StaticResource Brush.Surface}"
            BorderBrush="{StaticResource Brush.Border}"
            BorderThickness="1"
            CornerRadius="14"
            Padding="22,20">
        <Border.Effect>
            <DropShadowEffect BlurRadius="40" ShadowDepth="14" Opacity="0.45" Color="Black" />
        </Border.Effect>
        <StackPanel>
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <Border Width="30"
                            Height="30"
                            CornerRadius="8"
                            Background="#33F85149"
                            VerticalAlignment="Top">
                        <TextBlock Text="&#xE7BA;"
                                   FontFamily="{StaticResource Font.Icons}"
                                   FontSize="14"
                                   Foreground="{StaticResource Brush.Red}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <TextBlock x:Name="TitleText"
                               Text="确认操作"
                               FontFamily="{StaticResource Font.Display}"
                               FontSize="17"
                               FontWeight="SemiBold"
                               Margin="12,3,0,0" />
                </StackPanel>
            </Grid>
            <TextBlock x:Name="MessageText"
                       Text=""
                       FontSize="12.5"
                       Foreground="{StaticResource Brush.TextSecondary}"
                       TextWrapping="Wrap"
                       LineHeight="20"
                       Margin="0,16,0,0" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
                <Button Content="取消"
                        Style="{StaticResource BtnSecondary}"
                        Padding="18,7"
                        Click="Cancel_Click" />
                <Button x:Name="ConfirmButton"
                        Content="确定"
                        Style="{StaticResource BtnDanger}"
                        Padding="20,7"
                        Margin="8,0,0,0"
                        Click="Confirm_Click" />
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
