<UserControl x:Class="Lumen.Views.NamedPipeConnectView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="520"
             Focusable="True"
             KeyDown="Root_KeyDown">
    <Border Background="{StaticResource Brush.Surface}"
            BorderBrush="{StaticResource Brush.Border}"
            BorderThickness="1"
            CornerRadius="14">
        <Border.Effect>
            <DropShadowEffect BlurRadius="40" ShadowDepth="14" Opacity="0.45" Color="Black" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="58" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="64" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="22,0,12,0">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="连接命名管道"
                               FontFamily="{StaticResource Font.Display}"
                               FontSize="17"
                               FontWeight="SemiBold" />
                    <TextBlock Text="连接 com0com 等虚拟串口桥接的命名管道"
                               FontSize="11"
                               Foreground="{StaticResource Brush.TextMuted}"
                               Margin="0,2,0,0" />
                </StackPanel>
                <Button HorizontalAlignment="Right"
                        Style="{StaticResource BtnIcon}"
                        Content="&#xE711;"
                        Width="30"
                        Height="30"
                        FontSize="10"
                        ToolTip="关闭" AutomationProperties.Name="关闭"
                        Click="Cancel_Click" />
            </Grid>

            <StackPanel Grid.Row="1" Margin="22,2,22,18">
                <TextBlock Text="管道名称" Style="{StaticResource Text.Section}" Margin="0,4,0,8" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="6" />
                        <ColumnDefinition Width="34" />
                    </Grid.ColumnDefinitions>
                    <ComboBox x:Name="PipeBox"
                              Height="34"
                              IsEditable="True"
                              IsTextSearchEnabled="False"
                              ToolTip="选择或输入管道名，例如 com_1" />
                    <Button Grid.Column="2"
                            Style="{StaticResource BtnSecondary}"
                            FontFamily="{StaticResource Font.Icons}"
                            FontSize="11"
                            Padding="0"
                            ToolTip="刷新管道列表" AutomationProperties.Name="刷新管道列表"
                            Click="RefreshPipes_Click">
                        <TextBlock Text="&#xE72C;"
                                   FontFamily="{StaticResource Font.Icons}"
                                   FontSize="11"
                                   Foreground="{StaticResource Brush.TextSecondary}" />
                    </Button>
                </Grid>
                <TextBlock x:Name="HintText"
                           FontSize="11"
                           Foreground="{StaticResource Brush.TextMuted}"
                           TextWrapping="Wrap"
                           Margin="2,6,0,0" />
                <TextBlock x:Name="ErrorText"
                           FontSize="12"
                           Foreground="{StaticResource Brush.Red}"
                           TextWrapping="Wrap"
                           Margin="2,10,0,0" />
            </StackPanel>

            <Border Grid.Row="2"
                    BorderBrush="{StaticResource Brush.BorderSoft}"
                    BorderThickness="0,1,0,0"
                    Padding="22,12">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="取消"
                            Style="{StaticResource BtnSecondary}"
                            Padding="18,7"
                            Click="Cancel_Click" />
                    <Button Content="连接"
                            Style="{StaticResource BtnPrimary}"
                            Padding="22,7"
                            Margin="8,0,0,0"
                            Click="Connect_Click" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>
