<UserControl x:Class="Lumen.Views.SendBytesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="590"
             MaxHeight="720"
             Focusable="True"
             KeyDown="Root_KeyDown">
    <Border Background="{StaticResource Brush.Surface}"
            BorderBrush="{StaticResource Brush.Border}"
            BorderThickness="1"
            CornerRadius="14">
        <Border.Effect>
            <DropShadowEffect BlurRadius="40" ShadowDepth="14" Opacity="0.45" Color="Black" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="58" />
                <RowDefinition Height="*" />
                <RowDefinition Height="64" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="22,0,12,0">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="发送原始字节"
                               FontFamily="{StaticResource Font.Display}"
                               FontSize="17"
                               FontWeight="SemiBold" />
                    <TextBlock Text="输入文本、转义序列或十六进制字节，直接写入串口"
                               FontSize="11"
                               Foreground="{StaticResource Brush.TextMuted}"
                               Margin="0,2,0,0" />
                </StackPanel>
                <Button HorizontalAlignment="Right"
                        Style="{StaticResource BtnIcon}"
                        Content="&#xE711;"
                        Width="30"
                        Height="30"
                        FontSize="10"
                        ToolTip="关闭" AutomationProperties.Name="关闭"
                        Click="Cancel_Click" />
            </Grid>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="22,0,22,0">
                <StackPanel Margin="0,2,0,16">
                    <TextBlock Text="输入格式" Style="{StaticResource Text.Section}" Margin="0,4,0,8" />
                    <ComboBox x:Name="ModeBox"
                              Height="34"
                              SelectionChanged="ModeBox_SelectionChanged" />
                    <TextBlock x:Name="ModeHint"
                               FontSize="11"
                               Foreground="{StaticResource Brush.TextMuted}"
                               TextWrapping="Wrap"
                               Margin="2,6,0,12" />

                    <TextBox x:Name="InputBox"
                             Height="112"
                             AcceptsReturn="True"
                             TextWrapping="NoWrap"
                             VerticalContentAlignment="Top"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"
                             FontFamily="{StaticResource Font.Mono}"
                             FontSize="13"
                             TextChanged="InputBox_TextChanged" />

                    <Grid Margin="0,12,0,6">
                        <TextBlock Text="预览" Style="{StaticResource Text.Section}" VerticalAlignment="Center" />
                        <TextBlock x:Name="ByteCountText"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"
                                   FontSize="11"
                                   FontFamily="{StaticResource Font.Mono}"
                                   Foreground="{StaticResource Brush.TextMuted}" />
                    </Grid>
                    <Border Background="{StaticResource Brush.BgDeep}"
                            BorderBrush="{StaticResource Brush.Border}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="10">
                        <StackPanel>
                            <TextBlock x:Name="PreviewText"
                                       FontFamily="{StaticResource Font.Mono}"
                                       FontSize="12"
                                       Foreground="{StaticResource Brush.TextSecondary}"
                                       TextWrapping="Wrap" />
                            <TextBlock x:Name="PreviewAsciiText"
                                       FontFamily="{StaticResource Font.Mono}"
                                       FontSize="12"
                                       Foreground="{StaticResource Brush.Green}"
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>

                    <CheckBox x:Name="ClearAfterSendCheck"
                              Content="发送后清空输入框"
                              IsChecked="True"
                              Margin="2,12,0,0" />
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2"
                    BorderBrush="{StaticResource Brush.BorderSoft}"
                    BorderThickness="0,1,0,0"
                    Padding="22,12">
                <Grid>
                    <TextBlock x:Name="ErrorText"
                               VerticalAlignment="Center"
                               FontSize="12"
                               Foreground="{StaticResource Brush.Red}"
                               MaxWidth="300"
                               TextTrimming="CharacterEllipsis" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="取消"
                                Style="{StaticResource BtnSecondary}"
                                Padding="18,7"
                                Click="Cancel_Click" />
                        <Button x:Name="SendButton"
                                Content="发送字节"
                                Style="{StaticResource BtnPrimary}"
                                Padding="20,7"
                                Margin="8,0,0,0"
                                Click="Send_Click" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
