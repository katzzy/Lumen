<UserControl x:Class="Lumen.Views.SessionEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="590"
             MaxHeight="760"
             Focusable="True"
             KeyDown="Root_KeyDown">
    <Border Background="{StaticResource Brush.Surface}"
            BorderBrush="{StaticResource Brush.Border}"
            BorderThickness="1"
            CornerRadius="14">
        <Border.Effect>
            <DropShadowEffect BlurRadius="40" ShadowDepth="14" Opacity="0.45" Color="Black" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="58" />
                <RowDefinition Height="*" />
                <RowDefinition Height="64" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="22,0,12,0">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="HeaderText"
                               Text="新建会话"
                               FontFamily="{StaticResource Font.Display}"
                               FontSize="17"
                               FontWeight="SemiBold" />
                    <TextBlock Text="串口参数、日志与自动化"
                               FontSize="11"
                               Foreground="{StaticResource Brush.TextMuted}"
                               Margin="0,2,0,0" />
                </StackPanel>
                <Button HorizontalAlignment="Right"
                        Style="{StaticResource BtnIcon}"
                        Content="&#xE711;"
                        Width="30"
                        Height="30"
                        FontSize="10"
                        ToolTip="关闭" AutomationProperties.Name="关闭"
                        Click="Cancel_Click" />
            </Grid>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="22,0,22,0">
                <StackPanel Margin="0,0,0,18">
                    <TextBlock Text="基本" Style="{StaticResource Text.Section}" Margin="0,4,0,8" />
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="会话名称" Style="{StaticResource Text.Muted}" Margin="2,0,0,5" />
                            <TextBox x:Name="NameBox" Height="34" VerticalContentAlignment="Top" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="分组" Style="{StaticResource Text.Muted}" Margin="2,0,0,5" />
                            <TextBox x:Name="GroupBox" Height="34" VerticalContentAlignment="Top" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="厂商" Style="{StaticResource Text.Section}" Margin="0,6,0,8" />
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="VendorBox" Height="34" SelectionChanged="VendorBox_SelectionChanged">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DisplayName}" FontSize="12.5" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <Button Grid.Column="2"
                                Content="套用厂商模板"
                                Style="{StaticResource BtnSecondary}"
                                Height="34"
                                Padding="14,0"
                                AutomationProperties.Name="套用厂商模板"
                                Click="ApplyVendor_Click" />
                    </Grid>
                    <TextBlock x:Name="VendorHint"
                               FontSize="10.5"
                               Foreground="{StaticResource Brush.TextMuted}"
                               TextWrapping="Wrap"
                               Margin="2,0,0,12" />

                    <TextBlock Text="串口" Style="{StaticResource Text.Section}" Margin="0,10,0,8" />
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.35*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="0.8*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="0.8*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="端口" Style="{StaticResource Text.Muted}" Margin="2,0,0,5" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="6" />
                                    <ColumnDefinition Width="34" />
                                </Grid.ColumnDefinitions>
                                <ComboBox x:Name="PortBox" Height="34" />
                                <Button Grid.Column="2"
                                        Style="{StaticResource BtnSecondary}"
                                        FontFamily="{StaticResource Font.Icons}"
                                        FontSize="11"
                                        Padding="0"
                                        ToolTip="刷新串口" AutomationProperties.Name="刷新串口"
                                        Click="RefreshPorts_Click">
                                    <TextBlock Text="&#xE72C;"
                                               FontFamily="{StaticResource Font.Icons}"
                                               FontSize="11"
                                               Foreground="{StaticResource Brush.TextSecondary}" />
                                </Button>
                            </Grid>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="波特率" Style="{StaticResource Text.Muted}" Margin="2,0,0,5" />
                            <TextBox x:Name="BaudBox" Height="34" VerticalContentAlignment="Top" />
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <TextBlock Text="数据位" Style="{StaticResource Text.Muted}" Margin="2,0,0,5" />
                            <ComboBox x:Name="DataBitsBox" Height="34" />
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="校验" Style="{StaticResource Text.Muted}" Margin="2,0,0,5" />
                            <ComboBox x:Name="ParityBox" Height="34" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="停止位" Style="{StaticResource Text.Muted}" Margin="2,0,0,5" />
                            <ComboBox x:Name="StopBitsBox" Height="34" />
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <TextBlock Text="流控" Style="{StaticResource Text.Muted}" Margin="2,0,0,5" />
                            <ComboBox x:Name="FlowBox" Height="34" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="显示与记录" Style="{StaticResource Text.Section}" Margin="0,10,0,8" />
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="90" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="编码" Style="{StaticResource Text.Muted}" Margin="2,0,0,5" />
                            <ComboBox x:Name="EncodingBox" Height="34" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="日志目录（留空使用默认）" Style="{StaticResource Text.Muted}" Margin="2,0,0,5" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="6" />
                                    <ColumnDefinition Width="34" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="LogDirBox" Height="34" VerticalContentAlignment="Top" />
                                <Button Grid.Column="2"
                                        Style="{StaticResource BtnSecondary}"
                                        Padding="0"
                                        ToolTip="选择目录" AutomationProperties.Name="选择目录"
                                        Click="BrowseLogDir_Click">
                                    <TextBlock Text="&#xE8B7;"
                                               FontFamily="{StaticResource Font.Icons}"
                                               FontSize="12"
                                               Foreground="{StaticResource Brush.TextSecondary}" />
                                </Button>
                            </Grid>
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <TextBlock Text="字号" Style="{StaticResource Text.Muted}" Margin="2,0,0,5" />
                            <TextBox x:Name="FontSizeBox" Height="34" VerticalContentAlignment="Top" />
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="120" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="2,18,0,0">
                            <CheckBox x:Name="AutoLogCheck" Content="连接后自动记录日志" />
                            <CheckBox x:Name="AutoPagingCheck" Content="登录后按厂商命令自动关闭分页" Margin="0,8,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="粘贴每行延迟 (ms)" Style="{StaticResource Text.Muted}" Margin="2,0,0,5" />
                            <TextBox x:Name="PasteDelayBox" Height="34" VerticalContentAlignment="Top" />
                        </StackPanel>
                    </Grid>

                    <CheckBox x:Name="ConfirmPasteCheck"
                              Content="粘贴危险命令（erase / reload 等）前二次确认"
                              Margin="2,2,0,10" />

                    <TextBlock Text="连接后自动发送（每行一条，可留空）"
                               Style="{StaticResource Text.Section}"
                               Margin="0,10,0,8" />
                    <TextBox x:Name="InitCommandsBox"
                             Height="64"
                             AcceptsReturn="True"
                             TextWrapping="NoWrap"
                             VerticalContentAlignment="Top"
                             VerticalScrollBarVisibility="Auto"
                             FontFamily="{StaticResource Font.Mono}"
                             FontSize="12" />

                    <Grid Margin="0,14,0,8">
                        <TextBlock Text="快捷命令" Style="{StaticResource Text.Section}" VerticalAlignment="Center" />
                        <Button HorizontalAlignment="Right"
                                Content="+ 添加命令"
                                Style="{StaticResource BtnGhost}"
                                Padding="8,4"
                                FontSize="11.5"
                                Click="AddCommand_Click" />
                    </Grid>
                    <Border Background="{StaticResource Brush.BgDeep}"
                            BorderBrush="{StaticResource Brush.Border}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="8">
                        <ItemsControl x:Name="CommandsList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="128" />
                                            <ColumnDefinition Width="6" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="6" />
                                            <ColumnDefinition Width="58" />
                                            <ColumnDefinition Width="4" />
                                            <ColumnDefinition Width="24" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                                 Height="30"
                                                 Padding="8,5"
                                                 VerticalContentAlignment="Top"
                                                 ToolTip="按钮名称" />
                                        <TextBox Grid.Column="2"
                                                 Text="{Binding Command, UpdateSourceTrigger=PropertyChanged}"
                                                 Height="30"
                                                 Padding="8,5"
                                                 FontFamily="{StaticResource Font.Mono}"
                                                 FontSize="11.5"
                                                 VerticalContentAlignment="Top"
                                                 ToolTip="发送的命令" />
                                        <CheckBox Grid.Column="4"
                                                  IsChecked="{Binding Confirm}"
                                                  Content="确认"
                                                  FontSize="11"
                                                  VerticalAlignment="Center" />
                                        <Button Grid.Column="6"
                                                Style="{StaticResource BtnIcon}"
                                                Content="&#xE711;"
                                                Width="22"
                                                Height="22"
                                                FontSize="8"
                                                Tag="{Binding}"
                                                ToolTip="删除" AutomationProperties.Name="删除"
                                                Click="RemoveCommand_Click" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2"
                    BorderBrush="{StaticResource Brush.BorderSoft}"
                    BorderThickness="0,1,0,0"
                    Padding="22,12">
                <Grid>
                    <TextBlock x:Name="ErrorText"
                               VerticalAlignment="Center"
                               FontSize="11.5"
                               Foreground="{StaticResource Brush.Red}" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="取消"
                                Style="{StaticResource BtnSecondary}"
                                Padding="18,7"
                                Click="Cancel_Click" />
                        <Button Content="保存会话"
                                Style="{StaticResource BtnPrimary}"
                                Padding="20,7"
                                Margin="8,0,0,0"
                                Click="Save_Click" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
